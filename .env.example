# Copy to .env and fill in values.

# Required for the Flask backend (OpenAI).
OPENAI_API_KEY=

# Optional model override (default: gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# URL the Streamlit app POSTs to (default matches Flask on port 5000).
CHAT_API_URL=http://127.0.0.1:5000/chat

# URL the Flask backend uses to reach the Privacy Vault (default: port 5001).
VAULT_URL=http://127.0.0.1:5001

# MongoDB — Privacy Vault storage (credentials must match docker-compose.yml).
MONGO_USERNAME=admin
MONGO_PASSWORD=secret
MONGO_URI=mongodb://admin:secret@localhost:27017/
MONGO_DB=privacy_vault
